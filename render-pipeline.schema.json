{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZUENS2020/codex-render-pipeline/render-pipeline.schema.json",
  "title": "Codex Render Pipeline configuration",
  "type": "object",
  "required": ["project", "render", "monitor", "remote", "delivery"],
  "properties": {
    "project": {
      "type": "object", "required": ["name", "revision", "root", "blend_file"],
      "properties": {"name": {"type": "string"}, "revision": {"type": "string"}, "root": {"type": "string"}, "blend_file": {"type": "string"}}
    },
    "render": {
      "type": "object", "required": ["frames_dir", "state_file", "manifest_file", "start", "end", "fps", "width", "height", "engine", "device", "samples"],
      "properties": {
        "frames_dir": {"type": "string"}, "state_file": {"type": "string"}, "manifest_file": {"type": "string"},
        "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}, "fps": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "engine": {"type": "string"},
        "device": {"type": "string"}, "samples": {"type": "integer", "minimum": 1}, "denoise": {"type": "boolean"},
        "format": {"type": "string"}, "color_mode": {"type": "string"}, "color_depth": {"type": ["string", "integer"]}, "png_compression": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "monitor": {"type": "object", "required": ["host", "port", "dashboard_dir"], "properties": {"host": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "dashboard_dir": {"type": "string"}}},
    "remote": {"type": "object", "required": ["base_url"], "properties": {"base_url": {"type": "string"}, "poll_seconds": {"type": "integer", "minimum": 1}, "request_timeout_seconds": {"type": "integer", "minimum": 1}}},
    "delivery": {
      "type": "object", "required": ["frames_dir", "state_file", "output_dir", "ffmpeg", "ffprobe", "master", "variants"],
      "properties": {
        "frames_dir": {"type": "string"}, "state_file": {"type": "string"}, "output_dir": {"type": "string"}, "ffmpeg": {"type": "string"}, "ffprobe": {"type": "string"},
        "verify_source_hashes": {"type": "boolean"}, "verify_master_pixels": {"type": "boolean"},
        "master": {"$ref": "#/$defs/output"}, "variants": {"type": "array", "items": {"$ref": "#/$defs/output"}}
      }
    }
  },
  "$defs": {"output": {"type": "object", "required": ["filename", "codec", "pixel_format"], "properties": {"filename": {"type": "string"}, "codec": {"type": "string"}, "pixel_format": {"type": "string"}, "preset": {"type": "string"}, "crf": {"type": "number"}, "movflags": {"type": "string"}}}}
}
